---
type Line =
  | { kind: "prompt"; text: string }
  | { kind: "blank" }
  | {
      kind: "actor";
      actor: "Client" | "Operator" | "Verifier";
      text: string;
      wait?: number;
      status?: "ok" | "wait-final";
      meta?: string;
    }
  | { kind: "kv"; key: string; value: string }
  | { kind: "rule"; label: string }
  | { kind: "result"; text: string };

const lines: Line[] = [
  { kind: "prompt", text: "cargo run -p sightless --example credit_scoring_demo" },
  { kind: "blank" },

  { kind: "actor", actor: "Client", text: "Generating FHE keypair...", wait: 2300, status: "ok", meta: "(2.3s)" },
  { kind: "actor", actor: "Client", text: "Loading personal data:" },
  { kind: "kv", key: "income", value: "65000 €/year" },
  { kind: "kv", key: "debt_ratio", value: "0.28" },
  { kind: "kv", key: "credit_history", value: "7 years" },
  { kind: "kv", key: "late_payments", value: "0" },
  { kind: "actor", actor: "Client", text: "Encrypting features under FHE pubkey...", wait: 400, status: "ok", meta: "(0.4s)" },
  { kind: "actor", actor: "Client", text: "Building ComputeRequest with policy...", status: "ok" },
  { kind: "actor", actor: "Client", text: "POST http://localhost:8080/compute", wait: 600, status: "wait-final" },
  { kind: "blank" },

  { kind: "actor", actor: "Operator", text: "Received ComputeRequest (request_id: abc-...)" },
  { kind: "actor", actor: "Operator", text: "Validating policy & request (12 rules)...", status: "ok" },
  { kind: "actor", actor: "Operator", text: "Loading credit_risk_v3 model (encrypted weights)...", status: "ok" },
  { kind: "actor", actor: "Operator", text: "Evaluating weighted_sum_u8/v1 in FHE...", wait: 4700, status: "ok", meta: "(4.7s)" },
  { kind: "actor", actor: "Operator", text: "Building UnsignedReceipt + signing...", status: "ok" },
  { kind: "actor", actor: "Operator", text: "→ ComputeResponse (output_ciphertext: 12.4 KB)" },
  { kind: "blank" },

  { kind: "actor", actor: "Client", text: "Validating response (14 client rules)..." },
  { kind: "rule", label: "protocol_version match" },
  { kind: "rule", label: "request_id mirror" },
  { kind: "rule", label: "output_ciphertext deserialize" },
  { kind: "rule", label: "operator_signing_key OOB-trusted" },
  { kind: "rule", label: "Ed25519 signature verify" },
  { kind: "rule", label: "policy_id binding" },
  { kind: "rule", label: "pk_fhe_hash binding" },
  { kind: "rule", label: "input_ciphertext_hash binding" },
  { kind: "rule", label: "output_ciphertext_hash binding" },
  { kind: "actor", actor: "Client", text: "All 14 rules passed.", status: "ok" },
  { kind: "actor", actor: "Client", text: "Decrypting result with sk_fhe...", status: "ok" },
  { kind: "result", text: "Credit score: 742 — range: 300–850, low risk" },
  { kind: "blank" },

  { kind: "actor", actor: "Verifier", text: "Loaded receipt from disk: receipt-abc.json" },
  { kind: "actor", actor: "Verifier", text: "Loaded operator pk_op from trusted store...", status: "ok" },
  { kind: "actor", actor: "Verifier", text: "Validating receipt offline (no network)..." },
  { kind: "rule", label: "OOB-trusted operator key match" },
  { kind: "rule", label: "Ed25519 signature over JCS(unsigned)" },
  { kind: "rule", label: "protocol_version.major == 0" },
  { kind: "actor", actor: "Verifier", text: "Receipt is valid. Operator attests:" },
  { kind: "kv", key: "function", value: "weighted_sum_u8/v1" },
  { kind: "kv", key: "model", value: "credit_risk_v3" },
  { kind: "kv", key: "computed_at", value: "2026-08-15T14:32:18Z" },
  { kind: "kv", key: "input_hash", value: "9c9001b7…3cb888" },
  { kind: "kv", key: "output_hash", value: "60ea7d85…80ab" },
];

const stepsJson = JSON.stringify(lines);
---

<section id="demo">
  <div class="container">
    <div class="section-num"><span>§ 04 — Demo</span></div>
    <h2>
      End-to-end, in <em>one terminal session</em>.
    </h2>

    <p class="demo-intro">
      A worked example against the v0.1 reference implementation. The Client
      encrypts four credit features under TFHE, the Operator evaluates
      <code>weighted_sum_u8/v1</code> against the <code>credit_risk_v3</code>
      model without ever decrypting, and signs a Receipt the Verifier validates
      offline against <code>pk_op</code>. Every §7.6 validation rule — 12 on
      the Operator side, 14 on the Client side, 3 on the Verifier — is
      exercised on the wire.
    </p>

    <dl class="demo-specs">
      <div><dt>backend</dt><dd>TFHE via <code>tfhe-rs</code></dd></div>
      <div><dt>signature</dt><dd>Ed25519 over <code>JCS(unsigned)</code></dd></div>
      <div><dt>function</dt><dd><code>weighted_sum_u8/v1</code></dd></div>
      <div><dt>model</dt><dd><code>credit_risk_v3</code></dd></div>
      <div><dt>output</dt><dd><code>OwnerOnly</code> (§3.1)</dd></div>
      <div><dt>invoke</dt><dd><code>cargo run -p sightless --example credit_scoring_demo</code></dd></div>
    </dl>

    <div class="demo-roles">
      <div class="demo-role">
        <span class="actor-badge actor-client">Client</span>
        <span class="demo-role-text">
          Holds <code>sk_fhe</code>. Encrypts the input, runs the 14 client
          rules on the response, decrypts the result.
        </span>
      </div>
      <div class="demo-role">
        <span class="actor-badge actor-operator">Operator</span>
        <span class="demo-role-text">
          Never sees plaintext. Runs the 12 op rules, evaluates the function
          under FHE, signs the Receipt with <code>sk_op</code>.
        </span>
      </div>
      <div class="demo-role">
        <span class="actor-badge actor-verifier">Verifier</span>
        <span class="demo-role-text">
          Holds <code>pk_op</code> out-of-band. Validates the Receipt offline,
          anywhere, any time — never contacts the Operator.
        </span>
      </div>
    </div>

    <figure class="figure dark term-figure">
      <div class="term" data-term>
        <div class="term-overlay">
          <span class="term-clock" data-term-clock>00.0s</span>
          <button class="term-replay" data-term-replay aria-label="Replay">
            <span class="term-replay-icon">↻</span>
            <span>replay</span>
          </button>
        </div>
        <div class="term-body" data-term-body></div>
      </div>
      <div class="figure-caption">
        Fig. 04 — <strong>One request, one signed Receipt, one offline verification.</strong>
      </div>
    </figure>
  </div>
</section>

<script type="application/json" id="demo-steps" set:html={stepsJson} />

<script>
  type Step =
    | { kind: "prompt"; text: string }
    | { kind: "blank" }
    | {
        kind: "actor";
        actor: "Client" | "Operator" | "Verifier";
        text: string;
        wait?: number;
        status?: "ok" | "wait-final";
        meta?: string;
      }
    | { kind: "kv"; key: string; value: string }
    | { kind: "rule"; label: string }
    | { kind: "result"; text: string };

  const root = document.querySelector<HTMLElement>("[data-term]");
  const body = document.querySelector<HTMLElement>("[data-term-body]");
  const clockEl = document.querySelector<HTMLElement>("[data-term-clock]");
  const replayBtn = document.querySelector<HTMLButtonElement>("[data-term-replay]");
  const stepsScript = document.getElementById("demo-steps");

  if (root && body && clockEl && replayBtn && stepsScript) {
    const steps: Step[] = JSON.parse(stepsScript.textContent || "[]");

    const SPINNER = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
    const prefersReduced =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const TIME_SCALE = prefersReduced ? 0 : 1;

    let playId = 0;
    let clockHandle: number | null = null;
    let spinnerHandles: number[] = [];

    const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

    function fmtSec(ms: number) {
      const s = ms / 1000;
      return s.toFixed(1).padStart(4, "0") + "s";
    }

    function startClock() {
      const t0 = performance.now();
      const tick = () => {
        clockEl!.textContent = fmtSec(performance.now() - t0);
      };
      tick();
      clockHandle = window.setInterval(tick, 80);
    }

    function stopClock() {
      if (clockHandle != null) {
        clearInterval(clockHandle);
        clockHandle = null;
      }
    }

    function clearSpinners() {
      spinnerHandles.forEach((h) => clearInterval(h));
      spinnerHandles = [];
    }

    function spin(el: HTMLElement) {
      let i = 0;
      el.textContent = SPINNER[0];
      const h = window.setInterval(() => {
        i = (i + 1) % SPINNER.length;
        el.textContent = SPINNER[i];
      }, 80);
      spinnerHandles.push(h);
      return h;
    }

    function row(cls: string) {
      const r = document.createElement("div");
      r.className = `t-row ${cls}`;
      r.setAttribute("data-state", "in");
      return r;
    }

    function renderStep(s: Step): HTMLElement {
      if (s.kind === "blank") {
        const r = row("t-row-blank");
        r.innerHTML = "&nbsp;";
        return r;
      }
      if (s.kind === "prompt") {
        const r = row("t-row-prompt");
        r.innerHTML = `<span class="t-prompt">$</span><span class="t-cmd"></span>`;
        const cmd = r.querySelector<HTMLElement>(".t-cmd")!;
        cmd.textContent = s.text;
        return r;
      }
      if (s.kind === "kv") {
        const r = row("t-row-kv");
        r.innerHTML = `<span class="t-key"></span><span class="t-val"></span>`;
        r.querySelector<HTMLElement>(".t-key")!.textContent = `${s.key}:`;
        r.querySelector<HTMLElement>(".t-val")!.textContent = s.value;
        return r;
      }
      if (s.kind === "rule") {
        const r = row("t-row-rule");
        r.innerHTML = `<span class="t-label"></span><span class="t-leader"></span><span class="t-status t-ok">✓</span>`;
        r.querySelector<HTMLElement>(".t-label")!.textContent = s.label;
        return r;
      }
      if (s.kind === "result") {
        const r = row("t-row-result");
        r.innerHTML = `<span class="t-result-text"></span>`;
        r.querySelector<HTMLElement>(".t-result-text")!.textContent = s.text;
        return r;
      }
      // actor
      const r = row(`t-row-actor`);
      r.innerHTML = `
        <span class="t-actor actor-${s.actor.toLowerCase()}">[${s.actor}]</span>
        <span class="t-text"></span>
        <span class="t-leader t-leader-blank"></span>
        <span class="t-status"></span>
        <span class="t-meta"></span>
      `;
      r.querySelector<HTMLElement>(".t-text")!.textContent = s.text;
      const status = r.querySelector<HTMLElement>(".t-status")!;
      const meta = r.querySelector<HTMLElement>(".t-meta")!;
      if (s.status === "ok" && !s.wait) {
        status.classList.add("t-ok");
        status.textContent = "✓";
      }
      if (s.meta && !s.wait) meta.textContent = s.meta;
      return r;
    }

    async function play() {
      const myId = ++playId;
      clearSpinners();
      stopClock();
      body!.innerHTML = "";
      root!.dataset.state = "running";
      replayBtn!.dataset.visible = "false";
      startClock();

      const ALIVE = () => myId === playId;

      for (const s of steps) {
        if (!ALIVE()) return;
        const el = renderStep(s);
        body!.appendChild(el);
        body!.scrollTop = body!.scrollHeight;

        // base inter-line cadence
        let pre = 80;
        if (s.kind === "prompt") pre = 0;
        if (s.kind === "blank") pre = 60;
        if (s.kind === "kv") pre = 60;
        if (s.kind === "rule") pre = 70;
        if (s.kind === "result") pre = 250;
        if (s.kind === "actor") pre = 140;

        await sleep(pre * TIME_SCALE);

        if (s.kind === "actor" && s.wait) {
          const status = el.querySelector<HTMLElement>(".t-status")!;
          const meta = el.querySelector<HTMLElement>(".t-meta")!;
          status.classList.add("t-spin");
          const handle = spin(status);
          const start = performance.now();
          const tickMeta = () => {
            const elapsed = (performance.now() - start) / 1000;
            meta.textContent = `${elapsed.toFixed(1)}s`;
          };
          tickMeta();
          const metaHandle = window.setInterval(tickMeta, 80);
          spinnerHandles.push(metaHandle);

          await sleep((s.wait || 0) * TIME_SCALE);
          if (!ALIVE()) return;

          clearInterval(handle);
          clearInterval(metaHandle);
          spinnerHandles = spinnerHandles.filter(
            (h) => h !== handle && h !== metaHandle,
          );
          status.classList.remove("t-spin");
          if (s.status === "ok") {
            status.classList.add("t-ok");
            status.textContent = "✓";
          } else {
            status.classList.add("t-wait");
            status.textContent = "⏳";
          }
          meta.textContent = s.meta || "";
        }
      }

      if (!ALIVE()) return;
      stopClock();
      root!.dataset.state = "done";
      replayBtn!.dataset.visible = "true";
    }

    let started = false;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !started) {
            started = true;
            play();
            io.disconnect();
          }
        }
      },
      { threshold: 0.35 },
    );
    io.observe(root);

    replayBtn.addEventListener("click", () => {
      play();
    });
  }
</script>

<style>
  #demo .demo-intro {
    font-size: 19px;
    line-height: 1.55;
    max-width: none;
    margin: 0 0 28px;
    color: var(--ink-2);
  }
  #demo .demo-intro code {
    font-family: var(--mono);
    font-size: 14px;
    background: var(--paper-2);
    padding: 1px 6px;
    color: var(--ink);
  }

  #demo .demo-specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border: 1px solid var(--rule);
    background: var(--paper-2);
    margin: 0 0 24px;
    font-family: var(--mono);
  }
  @media (min-width: 760px) {
    #demo .demo-specs { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  #demo .demo-specs > div {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 12px;
    align-items: baseline;
    padding: 10px 16px;
    border-right: 1px solid rgba(20,17,13,0.08);
    border-bottom: 1px solid rgba(20,17,13,0.08);
    font-size: 12px;
    min-width: 0;
  }
  #demo .demo-specs > div:nth-child(3n) { border-right: none; }
  @media (max-width: 759px) {
    #demo .demo-specs > div { border-right: none; }
    #demo .demo-specs > div:nth-child(2n) { border-right: none; }
    #demo .demo-specs > div:nth-child(odd) { border-right: 1px solid rgba(20,17,13,0.08); }
  }
  #demo .demo-specs dt {
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 10px;
  }
  #demo .demo-specs dd {
    color: var(--ink);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  #demo .demo-specs code {
    font-size: 12px;
    background: transparent;
    padding: 0;
    color: var(--accent);
  }

  #demo .demo-roles {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin-bottom: 28px;
    padding: 18px 22px;
    border: 1px solid var(--rule);
    background: rgba(255, 252, 245, 0.55);
  }
  #demo .demo-role {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 18px;
    align-items: baseline;
  }
  #demo .demo-role-text {
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  #demo .demo-role-text code {
    background: var(--paper-2);
    padding: 0 4px;
    font-size: 11.5px;
  }
  @media (max-width: 640px) {
    #demo .demo-role { grid-template-columns: 1fr; gap: 4px; }
    #demo .demo-role .actor-badge { justify-self: start; }
  }

  .actor-badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    padding: 3px 8px;
    text-transform: uppercase;
    text-align: center;
    border: 1px solid currentColor;
  }
  .actor-badge.actor-client { color: var(--accent); }
  .actor-badge.actor-operator { color: var(--accent-2); }
  .actor-badge.actor-verifier {
    color: var(--ink);
    background: var(--highlight);
    border-color: var(--ink);
  }

  /* TERMINAL */
  .term-figure { padding: 0; overflow: hidden; }
  .term-figure::before { display: none; }
  .term-figure .figure-caption {
    margin-top: 0;
    padding: 12px 20px 14px;
    border-top: 1px dashed rgba(235,230,219,0.18);
  }

  .term {
    background: var(--code-bg);
    color: var(--code-fg);
    font-family: var(--mono);
    position: relative;
  }

  .term-overlay {
    position: absolute;
    top: 10px;
    right: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 2;
    pointer-events: none;
  }
  .term-overlay > * { pointer-events: auto; }

  .term-clock {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    color: rgba(235,230,219,0.5);
    font-variant-numeric: tabular-nums;
  }
  .term[data-state="running"] .term-clock { color: #d8a13a; }
  .term[data-state="running"] .term-clock::before {
    content: "";
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #d8a13a;
    margin-right: 6px;
    animation: pulseDot 1.1s infinite;
    vertical-align: 1px;
  }
  .term[data-state="done"] .term-clock { color: #8cb45a; }
  .term[data-state="done"] .term-clock::before {
    content: "";
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #8cb45a;
    margin-right: 6px;
    vertical-align: 1px;
  }
  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.85); }
  }

  .term-replay {
    background: rgba(20,17,13,0.7);
    border: 1px solid rgba(235,230,219,0.22);
    color: rgba(235,230,219,0.7);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: lowercase;
    padding: 3px 8px;
    cursor: pointer;
    display: none;
    align-items: center;
    gap: 5px;
    transition: color 0.15s, border-color 0.15s;
  }
  .term-replay[data-visible="true"] { display: inline-flex; }
  .term-replay:hover {
    color: var(--highlight);
    border-color: var(--highlight);
  }
  .term-replay-icon { font-size: 12px; line-height: 1; }

  .term-body {
    margin: 0;
    padding: 16px 20px 18px;
    font-size: 12.5px;
    line-height: 1.4;
    height: clamp(360px, 58vh, 520px);
    overflow-y: auto;
    overflow-x: auto;
    scroll-behavior: smooth;
  }
  .term-body::-webkit-scrollbar { width: 6px; height: 6px; }
  .term-body::-webkit-scrollbar-thumb {
    background: rgba(235,230,219,0.15);
    border-radius: 3px;
  }
  .term-body { scrollbar-width: thin; scrollbar-color: rgba(235,230,219,0.18) transparent; }

  /* rows */
  :global(.t-row) {
    display: flex;
    align-items: baseline;
    gap: 8px;
    white-space: nowrap;
    animation: rowIn 0.14s ease-out;
    padding: 1px 0;
  }
  @keyframes rowIn {
    from { opacity: 0; transform: translateY(1px); }
    to { opacity: 1; transform: none; }
  }
  :global(.t-row-blank) { height: 0.45em; padding: 0; }

  :global(.t-prompt) {
    color: var(--accent);
    font-weight: 600;
  }
  :global(.t-cmd) { color: var(--code-fg); }

  :global(.t-actor) {
    display: inline-block;
    flex: 0 0 10ch;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  :global(.t-actor.actor-client) { color: var(--accent); }
  :global(.t-actor.actor-operator) { color: var(--accent-2); }
  :global(.t-actor.actor-verifier) { color: var(--highlight); }

  :global(.t-text) {
    color: rgba(235,230,219,0.92);
    flex: 0 1 auto;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.t-leader) {
    flex: 1 1 16px;
    align-self: stretch;
    min-width: 16px;
  }
  :global(.t-row-rule .t-leader) {
    border-bottom: 1px dotted rgba(235,230,219,0.22);
    margin-bottom: 5px;
  }

  :global(.t-row-kv) {
    gap: 0;
  }
  :global(.t-key) {
    flex: 0 0 16ch;
    color: rgba(235,230,219,0.55);
  }
  :global(.t-val) { color: var(--highlight); }

  :global(.t-label) {
    color: rgba(235,230,219,0.78);
    flex: 0 1 auto;
  }

  :global(.t-status) {
    flex: 0 0 auto;
    font-weight: 600;
    min-width: 1.2em;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  :global(.t-status.t-ok) { color: #8cb45a; }
  :global(.t-status.t-wait) { color: #d8a13a; }
  :global(.t-status.t-spin) { color: #d8a13a; }

  :global(.t-meta) {
    flex: 0 0 auto;
    color: rgba(235,230,219,0.45);
    font-style: italic;
    min-width: 5ch;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  :global(.t-row-result) {
    margin: 2px 0;
  }
  :global(.t-result-text) {
    display: inline-block;
    color: var(--highlight);
    font-weight: 600;
    border-left: 2px solid var(--accent);
    padding: 2px 0 2px 10px;
  }

  @media (max-width: 640px) {
    .term-body {
      padding: 12px 12px 14px;
      font-size: 11px;
      line-height: 1.4;
      height: clamp(320px, 60vh, 480px);
